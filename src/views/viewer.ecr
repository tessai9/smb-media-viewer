<% parent_dir   = File.dirname(entry.path)
   browse_path  = parent_dir == "." ? "" : parent_dir %>
<div class="viewer">
  <nav class="viewer-nav">
    <a href="/browse/<%= browse_path %>" class="nav-back">← 一覧に戻る</a>
    <div class="nav-arrows">
      <% if pe = prev_entry %>
        <a href="/view/<%= pe.path %>" class="nav-prev">← 前へ</a>
      <% end %>
      <% if ne = next_entry %>
        <a href="/view/<%= ne.path %>" class="nav-next">次へ →</a>
      <% end %>
    </div>
  </nav>

  <div class="viewer-media">
    <% case entry.media_type
    when "image" %>
      <img src="/raw/<%= entry.path %>" alt="<%= entry.name %>">
    <% when "video" %>
      <video controls>
        <source src="/raw/<%= entry.path %>" type="<%= MimeService.content_type(entry.name) %>">
      </video>
    <% when "pdf" %>
      <object data="/raw/<%= entry.path %>" type="application/pdf" width="100%" height="800">
        <a href="/raw/<%= entry.path %>" download="<%= entry.name %>">ダウンロード</a>
      </object>
    <% end %>
  </div>

  <div class="viewer-info">
    <p class="filename"><%= entry.name %></p>
  </div>
</div>
