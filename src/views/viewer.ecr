<% parent_dir   = File.dirname(entry.path)
   browse_path  = parent_dir == "." ? "" : parent_dir %>
<div class="viewer">
  <nav class="viewer-nav">
    <a href="/browse/<%= URI.encode_path(browse_path) %>" class="nav-back">← 一覧に戻る</a>
    <div class="nav-arrows">
      <% if pe = prev_entry %>
        <a href="/view/<%= URI.encode_path(pe.path) %>" class="nav-prev">← 前へ</a>
      <% end %>
      <% if ne = next_entry %>
        <a href="/view/<%= URI.encode_path(ne.path) %>" class="nav-next">次へ →</a>
      <% end %>
    </div>
  </nav>

  <div class="viewer-media">
    <% case entry.media_type
    when "image" %>
      <img src="/raw/<%= URI.encode_path(entry.path) %>" alt="<%= entry.name %>">
    <% when "video" %>
      <video controls>
        <source src="/raw/<%= URI.encode_path(entry.path) %>" type="<%= MimeService.content_type(entry.name) %>">
      </video>
    <% when "pdf" %>
      <object data="/raw/<%= URI.encode_path(entry.path) %>" type="application/pdf" width="100%" height="800">
        <a href="/raw/<%= URI.encode_path(entry.path) %>" download="<%= entry.name %>">ダウンロード</a>
      </object>
    <% end %>
  </div>

  <div class="viewer-info">
    <p class="filename"><%= entry.name %></p>
  </div>

  <% if meta = ai_meta %>
  <details class="viewer-metadata">
    <summary class="meta-summary">AI生成情報</summary>
    <% if p = meta.prompt %>
    <div class="meta-section">
      <h3 class="meta-label">プロンプト</h3>
      <p class="meta-text"><%= p %></p>
    </div>
    <% end %>
    <% if np = meta.negative_prompt %>
    <div class="meta-section">
      <h3 class="meta-label">ネガティブプロンプト</h3>
      <p class="meta-text"><%= np %></p>
    </div>
    <% end %>
    <% unless meta.settings.empty? %>
    <div class="meta-section">
      <h3 class="meta-label">生成設定</h3>
      <dl class="meta-settings">
        <% meta.settings.each do |key, value| %>
        <dt><%= key %></dt><dd><%= value %></dd>
        <% end %>
      </dl>
    </div>
    <% end %>
  </details>
  <% end %>
</div>
